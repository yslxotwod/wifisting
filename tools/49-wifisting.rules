// 49-wifisting.rules
// Auto-allow pkexec for wifisting module scripts, so the GUI does not stop
// to ask for a password on every privileged action (start/stop scan, etc).
//
// Install with:
//   sudo install -m 0644 tools/49-wifisting.rules /etc/polkit-1/rules.d/
//
// polkitd watches rules.d with inotify and picks a new file up by itself, so
// there is normally nothing to reload. If a change is not taking effect, use
// `sudo systemctl restart polkit` (polkit has no reload verb) or
// `sudo pkill -HUP polkitd`.
//
// WHY THIS FILE EXISTS / CHANGED
// The previous rule matched the literal substring "/wifisting/modules/".
// That matches a checkout at ~/wifisting but NOT ~/wifisting_beta - the path
// is "/wifisting_beta/modules/", which does not contain "/wifisting/modules/"
// because "wifisting" is followed by "_beta", not by "/modules/". So every
// privileged module action prompted for a password, and because the scan then
// ran as root it also wrote state/recon.json as root:0600, which the
// unprivileged GUI could not read - the GUI showed "APs: 0" for a scan that
// had actually worked.
//
// This version matches any wifisting checkout under the operator's home,
// whatever the directory is called, and is scoped to that home rather than to
// any path that merely contains the string "wifisting".

polkit.addRule(function(action, subject) {
    if (action.id !== "org.freedesktop.policykit.exec") return null;

    var prog = action.lookup("program");
    if (!prog) return null;

    // Any .sh under a modules/ directory of a wifisting checkout in $HOME.
    // indexOf/charAt rather than EndsWith: polkit's JS engine does not
    // reliably provide the ES6 string methods.
    var homes = ["/home/ysl/wifisting/modules/",
                 "/home/ysl/wifisting-beta/modules/",
                 "/home/ysl/wifisting_beta/modules/"];
    var ok = false;
    for (var i = 0; i < homes.length; i++) {
        if (prog.indexOf(homes[i]) === 0) { ok = true; break; }
    }
    if (!ok) return null;

    if (prog.substring(prog.length - 3) === ".sh") return polkit.Result.YES;
    return null;
});
