// 49-wifisting.rules
// Auto-allow pkexec for wifisting module scripts, for EVERY user, so the GUI
// does not stop for a password on each privileged action (start/stop scan,
// attacks, dependency installs).
//
// Install once, as root:
//   sudo tools/install-polkit-rule.sh
// or, by hand:
//   sudo install -m 0644 tools/49-wifisting.rules /etc/polkit-1/rules.d/
//
// One installed copy serves every user on the machine: the rule reads
// subject.user at decision time instead of naming a home directory. An
// earlier version hardcoded /home/ysl, so every other user - and any checkout
// outside that one path - still got prompted on every action.
//
// polkitd watches rules.d with inotify and picks a new file up by itself, so
// there is normally nothing to reload. If a change is not taking effect:
//   sudo systemctl restart polkit      (polkit has no reload verb)
//   sudo pkill -HUP polkitd
//
// HOW IT MATCHES
// pkexec's "program" key is the first argument after pkexec, so callers must
// use `pkexec /path/to/script.sh --verb` and never `pkexec env ...` - the key
// would then be /usr/bin/env and nothing here would match. The GUI's action
// runner does exactly that.
//
// A program is allowed when ALL of these hold:
//   * it lives under the INVOKING user's home directory,
//   * the checkout directory name starts with "wifisting"
//     (wifisting, wifisting_beta, wifisting-1.2.0),
//   * it sits in a modules/ directory,
//   * it ends in ".sh".
// That keeps a script parked in /tmp (which the old substring match allowed)
// from being escalated, while still working for any user and any checkout.

polkit.addRule(function(action, subject) {
    if (action.id !== "org.freedesktop.policykit.exec") return null;

    var prog = action.lookup("program");
    if (!prog) return null;

    // The invoking user's home, resolved at decision time.
    var home = "/home/" + subject.user + "/";
    if (prog.indexOf(home) !== 0) return null;

    // Path below the home, e.g. "wifisting_beta/modules/02_recon.sh".
    // indexOf rather than startsWith: polkit's JS engine does not reliably
    // provide the ES6 string methods.
    var rest = prog.substring(home.length);
    if (rest.indexOf("wifisting") !== 0) return null;
    if (rest.indexOf("/modules/") === -1) return null;

    if (prog.substring(prog.length - 3) !== ".sh") return null;

    return polkit.Result.YES;
});
